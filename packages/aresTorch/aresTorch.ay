// ============================================================
// CONSTANTES E UTILIDADES
// ============================================================

fn atx_clamp(x: double, lo: double, hi: double) -> double {
    if x < lo {
        return lo
    }

    if x > hi {
        return hi
    }

    return x
}

fn atx_abs(x: double) -> double {
    if x < 0.0 {
        return -x
    }

    return x
}


// ============================================================
// ATIVAÇÕES
// ============================================================

fn relu(x: double) -> double {
    if x > 0.0 {
        return x
    }

    return 0.0
}

fn relu_derivative(x: double) -> double {
    if x > 0.0 {
        return 1.0
    }

    return 0.0
}

fn leaky_relu(x: double) -> double {
    if x > 0.0 {
        return x
    }

    return 0.01 * x
}

fn leaky_relu_derivative(x: double) -> double {
    if x > 0.0 {
        return 1.0
    }

    return 0.01
}

fn sigmoid(x: double) -> double {
    if x >= 0.0 {
        return 1.0 / (1.0 + exp(-x))
    }

    var e = exp(x)
    return e / (1.0 + e)
}

fn sigmoid_derivative(x: double) -> double {
    var s = sigmoid(x)
    return s * (1.0 - s)
}

fn tanh_activation(x: double) -> double {
    var ep = exp(x)
    var en = exp(-x)

    return (ep - en) / (ep + en)
}

fn tanh_derivative(x: double) -> double {
    var t = tanh_activation(x)
    return 1.0 - t * t
}

fn softplus(x: double) -> double {
    if x > 20.0 {
        return x
    }

    return log(1.0 + exp(x))
}

fn softplus_derivative(x: double) -> double {
    return sigmoid(x)
}

fn swish(x: double) -> double {
    return x * sigmoid(x)
}

fn swish_derivative(x: double) -> double {
    var s = sigmoid(x)
    return s + x * s * (1.0 - s)
}

fn gelu(x: double) -> double {
    var c = 0.7978845608
    var k = 0.044715

    var inner =
        c * (x + k * x * x * x)

    return 0.5 * x * (1.0 + tanh_activation(inner))
}


// ============================================================
// PERDAS
// ============================================================

fn mse(pred: double, target: double) -> double {
    var d = pred - target
    return d * d
}

fn mae(pred: double, target: double) -> double {
    return atx_abs(pred - target)
}

fn rmse(pred: double, target: double) -> double {
    return sqrt(mse(pred, target))
}

fn huber(pred: double, target: double, delta: double) -> double {
    var d = atx_abs(pred - target)

    if d <= delta {
        return 0.5 * d * d
    }

    return delta * (d - 0.5 * delta)
}

fn binary_cross_entropy(pred: double, target: double) -> double {
    var p =
        atx_clamp(
            pred,
            0.0000001,
            0.9999999
        )

    return -(
        target * log(p) +
        (1.0 - target) *
        log(1.0 - p)
    )
}


// ============================================================
// DERIVADAS DAS PERDAS
// ============================================================

fn mse_gradient(pred: double, target: double) -> double {
    return 2.0 * (pred - target)
}

fn mae_gradient(pred: double, target: double) -> double {
    if pred > target {
        return 1.0
    }

    if pred < target {
        return -1.0
    }

    return 0.0
}

fn bce_gradient(pred: double, target: double) -> double {
    var p =
        atx_clamp(
            pred,
            0.0000001,
            0.9999999
        )

    return -(target / p) +
           ((1.0 - target) / (1.0 - p))
}


// ============================================================
// SOFTMAX
// ============================================================

fn softmax2(a: double, b: double) -> double {
    var ea = exp(a)
    var eb = exp(b)

    return ea / (ea + eb)
}

fn softmax3(a: double, b: double, c: double) -> double {
    var ea = exp(a)
    var eb = exp(b)
    var ec = exp(c)

    return ea / (ea + eb + ec)
}

fn softmax4(a: double, b: double, c: double, d: double) -> double {
    var ea = exp(a)
    var eb = exp(b)
    var ec = exp(c)
    var ed = exp(d)

    return ea / (ea + eb + ec + ed)
}

fn softmax_component(x: double, total: double) -> double {
    return exp(x) / total
}


// ============================================================
// ÁLGEBRA ESCALAR
// ============================================================

fn dot2(a: double, b: double, c: double, d: double) {
    return a * c + b * d
}

fn dot3(
    a: double,
    b: double,
    c: double,
    d: double,
    e: double,
    f: double
) {
    return a * d + b * e + c * f
}

fn dot4(
    a: double,
    b: double,
    c: double,
    d: double,
    e: double,
    f: double,
    g: double,
    h: double
) {
    return a * e + b * f + c * g + d * h
}


// ============================================================
// INICIALIZAÇÃO
// ============================================================

fn uniform(seed: i64, scale: double) -> double {
    var r = random(seed)
    return (r / seed) * 2.0 * scale - scale
}

fn xavier_value(fan_in: i64, fan_out: i64) -> double {
    var denom =
        fan_in + fan_out

    var limit =
        sqrt(6.0 / denom)

    var r =
        random(1000000)

    var x =
        r / 1000000.0

    return (2.0 * x - 1.0) * limit
}

fn he_value(fan_in: i64) -> double {
    var std =
        sqrt(2.0 / fan_in)

    var r =
        random(1000000)

    var x =
        r / 1000000.0

    return (2.0 * x - 1.0) * std
}


// ============================================================
// NORMALIZAÇÃO
// ============================================================

fn normalize_minmax(
    x: double,
    minimum: double,
    maximum: double
) -> double {
    if maximum == minimum {
        return 0.0
    }

    return (x - minimum) /
           (maximum - minimum)
}

fn normalize_standard(
    x: double,
    mean_value: double,
    std_value: double
) -> double {
    if std_value == 0.0 {
        return 0.0
    }

    return (x - mean_value) /
           std_value
}


// ============================================================
// OTIMIZAÇÃO
// ============================================================

fn sgd(weight: double, gradient: double, lr: double) -> double {
    return weight - lr * gradient
}

fn momentum(
    weight: double,
    gradient: double,
    velocity: double,
    lr: double,
    beta: double
) {
    var v =
        beta * velocity +
        (1.0 - beta) * gradient

    return weight - lr * v
}

fn adam_weight(
    weight: double,
    gradient: double,
    first: double,
    second: double,
    lr: double,
    beta1: double,
    beta2: double,
    epsilon: double
) {
    var m =
        beta1 * first +
        (1.0 - beta1) * gradient

    var v =
        beta2 * second +
        (1.0 - beta2) *
        gradient * gradient

    var update =
        lr * m /
        (sqrt(v) + epsilon)

    return weight - update
}


// ============================================================
// MÉTRICAS
// ============================================================

fn accuracy_binary(
    prediction: double,
    target: double
) {
    var p = 0

    if prediction >= 0.5 {
        p = 1
    }

    if p == target {
        return 1.0
    }

    return 0.0
}

fn r2_score(
    prediction: double,
    target: double,
    target_mean: double
) {
    var numerator =
        (prediction - target) *
        (prediction - target)

    var denominator =
        (target - target_mean) *
        (target - target_mean)

    if denominator == 0.0 {
        return 0.0
    }

    return 1.0 -
           numerator / denominator
}


// ============================================================
// NEURÔNIO
// ============================================================

fn neuron_linear(
    x1: double,
    x2: double,
    w1: double,
    w2: double,
    bias: double
) {
    return x1 * w1 +
           x2 * w2 +
           bias
}

fn neuron_relu(
    x1: double,
    x2: double,
    w1: double,
    w2: double,
    bias: double
) {
    return relu(
        neuron_linear(
            x1,
            x2,
            w1,
            w2,
            bias
        )
    )
}

fn neuron_sigmoid(
    x1: double,
    x2: double,
    w1: double,
    w2: double,
    bias: double
) {
    return sigmoid(
        neuron_linear(
            x1,
            x2,
            w1,
            w2,
            bias
        )
    )
}


// ============================================================
// XOR — PEQUENA REDE COMPLETA
// ============================================================

fn xor_hidden1(x1: double, x2: double) {
    var z =
        x1 * 20.0 +
        x2 * 20.0 -
        10.0

    return sigmoid(z)
}

fn xor_hidden2(x1: double, x2: double) {
    var z =
        x1 * 20.0 +
        x2 * 20.0 -
        30.0

    return sigmoid(z)
}

fn xor_output(h1: double, h2: double) {
    var z =
        h1 * 20.0 -
        h2 * 20.0 -
        10.0

    return sigmoid(z)
}

fn xor_predict(x1: double, x2: double) {
    var h1 =
        xor_hidden1(x1, x2)

    var h2 =
        xor_hidden2(x1, x2)

    return xor_output(h1, h2)
}


// ============================================================
// REGRESSÃO LINEAR
// ============================================================

fn linear_predict(
    x: double,
    weight: double,
    bias: double
) {
    return x * weight + bias
}

fn linear_gradient_weight(
    x: double,
    prediction: double,
    target: double
) {
    return 2.0 *
           x *
           (prediction - target)
}

fn linear_gradient_bias(
    prediction: double,
    target: double
) {
    return 2.0 *
           (prediction - target)
}


// ============================================================
// CHECKSUM / BENCHMARK
// ============================================================

fn checksum_scalar(
    value: double,
    repetitions: i64
) {
    var total = 0.0
    var i = 0

    while i < repetitions {
        total =
            total +
            value

        i = i + 1
    }

    return total
}

fn polynomial(
    x: double,
    a: double,
    b: double,
    c: double
) {
    return a * x * x +
           b * x +
           c
}


